# Default deny: only reviewed application code and templates are tracked.
/*
!/.gitignore
!/README.md
!/.env.example
!/preferences.example.json
!/package.json
!/bun.lock
!/tsconfig.json
!/compose.yaml
!/browser-sources.json
!/src/
/src/*
!/src/*.ts
!/web/
/web/*
!/web/*.html
!/web/*.js
!/web/*.css
!/extension/
/extension/*
!/extension/*.json
!/extension/*.js
!/extension/*.mjs
!/extension/*.mts
!/extension/*.html
!/extension/*.css
!/docker/
/docker/*
!/docker/browser/
/docker/browser/*
!/docker/browser/Dockerfile
!/docker/browser/start.sh
!/prompts/
/prompts/*
!/prompts/application-chat.md
!/prompts/application-editor.md
!/prompts/application-writer.md
!/prompts/unslop.md
!/scripts/
/scripts/*
!/scripts/service.ts
!/scripts/setup-mail.ts
!/scripts/setup-remote.ts
!/scripts/connect-localbase.ts
!/scripts/smoke-localbase.ts
!/scripts/validate-data.ts
!/scripts/check-http.ts
!/scripts/check-browser-ui.ts
# Never publish runtime data, credentials, personal briefs, or local configuration.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.sqlite*
*.log
*.bak
.DS_Store
node_modules/
data/
reports/
drafts/
prompts/jobs/
preferences.json
runtime.json
